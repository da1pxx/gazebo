<?xml version="1.0"?>
<!--
  gps_obstacles.world
  Start A = (-9, 0), finish B = (9, 0). World frame: x = East, y = North (ENU).
  The map frame of robot_localization coincides with this world frame because the
  navsat datum = <spherical_coordinates> origin below.
-->
<sdf version="1.6">
  <world name="gps_obstacles">

    <!-- Geodetic origin of the world. Longitude 39.0 = central meridian of UTM zone 37,
         so even a UTM-based navsat_transform has zero grid convergence here. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>55.751244</latitude_deg>
      <longitude_deg>39.0</longitude_deg>
      <elevation>150.0</elevation>
      <!-- Gazebo Classic bug: heading 180 is needed to get a true ENU world
           (see Nav2 GPS tutorial / gazebo-classic issue #2022). Verify with README section "GPS check". -->
      <heading_deg>180</heading_deg>
    </spherical_coordinates>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0 -16 14 0 0.75 1.5708</pose>
      </camera>
    </gui>

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <!-- ===== Boundary walls (23.4 x 12 m arena) ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 6.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>23.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>23.4 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -6.1 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>23.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>23.4 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>11.6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-11.6 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 12.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 12.4 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ===== Static obstacles (all block the straight line between consecutive waypoints) ===== -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>-6.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 2.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 2.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_cyl_1">
      <static>true</static>
      <pose>-6.0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_cyl_2">
      <static>true</static>
      <pose>-3.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_2">
      <static>true</static>
      <pose>0.0 0.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 1.5 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 1.5 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_cyl_3">
      <static>true</static>
      <pose>3.0 1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_box_3">
      <static>true</static>
      <pose>6.0 -1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 2.0 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 2.0 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_cyl_4">
      <static>true</static>
      <pose>6.0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/DarkGrey</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ===== Start (A) and finish (B) zones: visual only, no collision ===== -->
    <model name="start_zone_A">
      <static>true</static>
      <pose>-9.0 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>
    <model name="finish_zone_B">
      <static>true</static>
      <pose>9.0 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>2.0 2.0 0.01</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
